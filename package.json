{
  "name": "jobs2-graphai-eu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/job-key.test.ts lib/operators.test.ts lib/entitlement.test.ts lib/revolut.test.ts lib/clerk-runtime.test.ts lib/skills-catalog.test.ts lib/skill-tags.test.ts lib/stripe.test.ts lib/bar-scale.test.ts lib/location.test.ts lib/country.test.ts lib/availability.test.ts lib/spike-series.test.ts lib/locales.test.ts lib/job-boards.test.ts lib/text-diff.test.ts",
    "bq:gen-skill-tags": "tsx scripts/bq/gen_skill_tags.ts",
    "bq:patch-skills": "bq query --project_id=poetic-sentinel-402405 --location=EU --use_legacy_sql=false --nouse_legacy_sql < scripts/bq/patch_skills.sql",
    "test:e2e": "playwright test",
    "test:pentest": "node scripts/pentest/run.mjs",
    "bq:ddl": "bash scripts/bq/apply_ddl.sh",
    "bq:materialize": "bq query --project_id=poetic-sentinel-402405 --location=EU --use_legacy_sql=false --nouse_legacy_sql < scripts/bq/materialize.sql",
    "bq:gen-patches": "tsx scripts/bq/gen_patches.ts",
    "bq:patch-specialties": "bq query --project_id=poetic-sentinel-402405 --location=EU --use_legacy_sql=false --nouse_legacy_sql < scripts/bq/patch_specialties.sql",
    "bq:patch-locations": "bq query --project_id=poetic-sentinel-402405 --location=EU --use_legacy_sql=false --nouse_legacy_sql < scripts/bq/patch_locations.sql",
    "bq:patch-boards": "bq query --project_id=poetic-sentinel-402405 --location=EU --use_legacy_sql=false --nouse_legacy_sql < scripts/bq/patch_job_boards.sql",
    "bq:rollups": "bq query --project_id=poetic-sentinel-402405 --location=EU --use_legacy_sql=false --nouse_legacy_sql < scripts/bq/rebuild_rollups.sql",
    "bq:certs": "bq query --project_id=poetic-sentinel-402405 --location=EU --use_legacy_sql=false --nouse_legacy_sql < scripts/bq/refresh_job_offer_certs.sql",
    "bq:sync-dev": "bash scripts/bq/sync_dev.sh",
    "bq:translate": "python3 scripts/bq/translate_job_offers.py",
    "bq:snapshot": "bash scripts/bq/snapshot.sh",
    "import:certs": "python3 scripts/import_clickhouse_skill_certs.py",
    "import:kpi": "python3 scripts/import_kpi.py",
    "worker:availability": "python3 scripts/availability_worker.py"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.7",
    "@google-cloud/bigquery": "^9.1.0",
    "@sentry/nextjs": "^11.0.0",
    "leaflet": "^1.9.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
